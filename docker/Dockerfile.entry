# Tests of the entry scripts and compose files (scripts/run_entry_tests.sh): shell logic against FAKE docker commands, static checks of the
# compose files (PyYAML), image pins, isolation rules. No network, no Docker socket, nothing of the project is baked in (mounted at run time).
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-yaml python3-pytest bash \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
