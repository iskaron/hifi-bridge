# Flash tool GUI image (phase 2b, step 7): PySide6 + pytest-qt under QT_QPA_PLATFORM=offscreen, coverage, screenshots and the Linux
# one-folder package (PyInstaller). Lab/CI only - never shipped. No host device is visible inside: tests use SIMULATED cards (regular files)
# and recorded tool outputs only. The OS tools (openssl, mtools, dosfstools, fdisk) are here so tests/flashtool (core) runs in the same
# image and the coverage of the whole flash tool is measured in one place.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv libpython3.13 ca-certificates openssl mtools dosfstools fdisk binutils file xz-utils \
      libgl1 libegl1 libxkbcommon0 libfontconfig1 libfreetype6 libglib2.0-0 libdbus-1-3 \
      fonts-dejavu-core fonts-urw-base35 \
 && rm -rf /var/lib/apt/lists/*
# Exact pins (all released >= 2 weeks before 2026-11-18). PySide6 = Qt for Python, LGPL-3.0 (docs/THIRD_PARTY.md).
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir \
      PySide6==6.12.0 cryptography==50.0.2 pytest==8.4.2 pytest-qt==4.5.0 coverage==7.16.2 pyinstaller==6.22.3
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 QT_QPA_PLATFORM=offscreen \
    PYTHONPATH=/work/bridge:/work/flashtool:/work/tests/os
WORKDIR /work
