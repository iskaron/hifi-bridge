# Disposable lab image: bridge runtime (stdlib python), test tooling, software
# Squeezelite players and analysis helpers. Everything runs in containers; the
# development host only needs Docker + Compose.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-numpy python3-pytest python3-coverage python3-jeepney dbus squeezelite flac procps curl ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
# Squeezelite/bridge/test code is bind-mounted at /work at run time.
WORKDIR /work
ENV PYTHONPATH=/work/bridge:/work/testkit
ENTRYPOINT ["/usr/bin/tini", "--"]
