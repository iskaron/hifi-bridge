# Real rsyslog with TLS (RFC 5425) as the remote-syslog peer for the bridge's optional secure syslog.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update && apt-get install -y --no-install-recommends rsyslog rsyslog-gnutls tini && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["rsyslogd", "-n", "-f", "/etc/rsyslog-lab/rsyslog.conf"]
