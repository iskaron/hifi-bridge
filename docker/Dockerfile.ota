# OTA test image (update stream, docs/OTA.md): the OS tooling image plus the pieces needed to run a REAL RAUC D-Bus service on a private
# bus inside a disposable container:
#  * rauc-service: the upstream D-Bus policy, interface XML and service wrapper (the `rauc service` mode itself is in the rauc binary),
#  * python3-jeepney: the bridge's only optional runtime dependency (DECISIONS #26), for the bridge's RAUC client,
#  * libubootenv-tool: fw_printenv/fw_setenv, so RAUC's U-Boot backend writes a FILE-BACKED U-Boot environment (no device, no loop).
# Lab/CI only. Nothing here is installed on the development host.
FROM btbridge-os:dev
RUN apt-get update && apt-get install -y --no-install-recommends rauc-service python3-jeepney libubootenv-tool \
 && rm -rf /var/lib/apt/lists/*
