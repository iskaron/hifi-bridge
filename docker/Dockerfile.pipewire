# Disposable PipeWire test image: a real PipeWire daemon + WirePlumber + pipewire-pulse WITHOUT any audio hardware.
# Used to verify the bridge's capture command lines (pw-cat / parec) against real PipeWire tools.
# BASE selects the PipeWire generation: debian bookworm-slim (0.3.65) or trixie-slim (1.x), each pinned by digest (docker/image-pins.txt).
ARG BASE=debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      pipewire pipewire-bin pipewire-pulse wireplumber pulseaudio-utils dbus dbus-bin python3 python3-numpy python3-pytest procps tini \
 && (apt-get install -y --no-install-recommends dbus-daemon || true) \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
ENV PYTHONPATH=/work/bridge:/work/testkit:/work/hwkit XDG_RUNTIME_DIR=/run/pw
ENTRYPOINT ["/usr/bin/tini", "--"]
