# Real Avahi (mDNS/DNS-SD) as an independent peer to test the bridge's own mDNS responder against.
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update && apt-get install -y --no-install-recommends avahi-daemon avahi-utils dbus python3 python3-jeepney procps tini \
 && rm -rf /var/lib/apt/lists/* \
 && sed -i 's/^#\?enable-dbus=.*/enable-dbus=yes/; s/^#\?use-ipv6=.*/use-ipv6=no/' /etc/avahi/avahi-daemon.conf
ENTRYPOINT ["/usr/bin/tini", "--"]
