# Handoff report is intentionally versionable when reviewed; redact secrets first.

# Keep the reviewed phase-1 evidence log (tokens are redacted)
!reports/evidence/*.log
.claude/settings.local.json
# Browser-test screenshots are regenerated by scripts/run_browser.sh; a curated set is versioned for review
reports/screenshots/*.png
!reports/screenshots/01-setup-mobile-light.png
!reports/screenshots/05-dashboard-playing-mobile-light.png
!reports/screenshots/08-dashboard-mobile-dark.png
!reports/screenshots/08-dashboard-desktop-dark.png
!reports/screenshots/09-settings-desktop-light.png
!reports/screenshots/10-dashboard-desktop-light-de.png
!reports/screenshots/07-settings-overview-mobile-light.png
!reports/screenshots/07-settings-access-mobile-light.png
!reports/screenshots/11-trust-https-webkit.png

# lab state on the host filesystem (independent of the Docker data filesystem)
.lab/

# phase-2b: release CA public certificate may be versioned once it exists (never a key)
!os/br2-external/board/hifi-bridge/keys/release-ca.pem
.keys/

# demo: host-side output of make demo-trust (verified device CA)
.demo/
