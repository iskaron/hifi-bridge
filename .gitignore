# Handoff report is intentionally versionable when reviewed; redact secrets first.

# Keep the reviewed phase-1 evidence log (tokens are redacted)
!reports/evidence/*.log
.claude/settings.local.json
# Browser-test screenshots are regenerated by scripts/run_browser.sh; a curated set is versioned for review
reports/screenshots/*.png
!reports/screenshots/01-setup-mobile-light.png
!reports/screenshots/05-dashboard-playing-mobile-light.png
!reports/screenshots/08-dashboard-mobile-dark.png
