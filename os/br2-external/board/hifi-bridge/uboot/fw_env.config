# U-Boot environment for fw_printenv/fw_setenv (RAUC's U-Boot backend). Two copies on the boot FAT, exactly as U-Boot keeps them
# (CONFIG_ENV_REDUNDANT, uboot.fragment); the size is rpi_arm64's CONFIG_ENV_SIZE (checked against the U-Boot build by the image check).
# File  Offset  Size
/boot/uboot.env 0x0000 0x4000
/boot/uboot-redund.env 0x0000 0x4000
