# Hi-Fi Bridge card layout (DECISIONS #120): boot FAT 64 MiB | rootfs-A 384 MiB | rootfs-B 384 MiB | data 256 MiB, grown to the rest of
# the card on first boot. The sizes are fixed for the life of a device (an update cannot repartition the card); the single source of the
# numbers is os/storage.json (checked against this file by tests/os/test_persistence_layout.py, the data size is derived in
# docs/PERSISTENCE.md). The slot size comes from BR2_TARGET_ROOTFS_EXT2_SIZE (rootfs.ext4 = slot A; slot B gets the same size).
# MBR because the Pi 3 / Zero 2 W boot ROM cannot read GPT. The boot file list is filled in by post-image.sh.
image boot.vfat {
	vfat {
		label = "HIFIBOOT"
		# constant volume serial and label time (Buildroot's mkfs.vfat draws them at random / from the clock; found by two clean builds)
		extraargs = "--invariant"
		files = {
#BOOT_FILES#
		}
	}
	size = 64M
}

image data.ext4 {
	ext4 {
		label = "hifi-data"
		use-mke2fs = true
		# fixed UUID and hash seed: otherwise every build differs (mounted by partition, never by UUID; docs/IMAGE_BUILD.md).
		# 4 KiB blocks and one inode per 64 KiB: mke2fs would choose 1 KiB blocks and one inode per 4 KiB below 512 MiB (16 MiB of
		# inode tables for a few hundred files, and 1 KiB blocks forever after the growth to the card size; docs/PERSISTENCE.md).
		fs-timestamp = "#FS_TIMESTAMP#"
		extraargs = "-b 4096 -i 65536 -U 3f6c2a91-7d4e-4b8a-a1c5-92e0d7b46f13 -E hash_seed=3f6c2a91-7d4e-4b8a-a1c5-92e0d7b46f13"
	}
	size = 256M
}

image sdcard.img {
	hdimage {
		partition-table-type = "mbr"
		# every partition starts on a 4 MiB boundary (SD erase-block size; without it genimage starts the FAT at sector 1)
		align = 4M
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs-a {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	# slot B: same size as A, empty on a fresh card (BOOT_B_LEFT=0 in boot.cmd until RAUC installs it)
	partition rootfs-b {
		partition-type = 0x83
		size = #ROOTFS_SIZE#
	}

	# data: grows to the card size on first boot (hifi-bridge-growdata.service + x-systemd.growfs)
	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
