# DHCP for setup-hotspot clients on %I (dnsmasq with DNS disabled, no default route), only while the hotspot runs.
[Unit]
Description=Hi-Fi Bridge setup hotspot DHCP on %I
Conflicts=hifi-net-wpa@%i.service
BindsTo=hifi-net-hostapd@%i.service
After=hifi-net-hostapd@%i.service

[Service]
ExecStart=/usr/sbin/dnsmasq -k -C /run/hifi-net/dnsmasq.conf
Restart=on-failure
RestartSec=2
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/hifi-net
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
