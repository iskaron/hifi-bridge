#!/usr/sbin/nft -f
# base ruleset loaded by hifi-firewall.service = netrender.nftables(80, 443, 8090) (pinned by tests/unit/test_network_os.py)
table inet hifi
delete table inet hifi
table inet hifi {
	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ct state invalid drop
		ct state established,related accept
		meta l4proto icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		meta l4proto icmp icmp type echo-request limit rate 10/second burst 20 packets accept
		meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query } accept
		meta l4proto ipv6-icmp icmpv6 type echo-request limit rate 10/second burst 20 packets accept
		udp dport 5353 accept
		udp sport 67 udp dport 68 accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
		udp sport 3483 udp dport 3484 accept
		tcp dport { 80, 443, 8090 } accept
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
