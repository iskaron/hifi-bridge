# Internal DEVELOPMENT build (scripts/os_build.sh), applied on top of configs/hifi_bridge_<board>_defconfig. Not part of the committed
# defconfigs: an image built from those alone still fails until the update trust is chosen explicitly (docs/UPDATE_TRUST.md).
#  * variant "development": marked in os-release, /etc/hifi-bridge/build-info.json and the image file name; NOT hardware-validated;
#  * update trust "own": a TEMPORARY development CA generated by scripts/os_dev_ca.sh into the git-ignored lab directory. Only its public
#    certificate is mounted into the build container (/devca/ca.pem); the private keys never enter it and are never committed.
#  * download directory and ccache on the host filesystem (mounted by scripts/os_build.sh); BR2_JLEVEL is appended by the script.
BR2_PACKAGE_HIFI_BRIDGE_BUILD_VARIANT="development"
BR2_PACKAGE_HIFI_BRIDGE_UPDATE_TRUST_OWN=y
BR2_PACKAGE_HIFI_BRIDGE_OWN_UPDATE_CA="/devca/ca.pem"
BR2_DL_DIR="/dl"
BR2_CCACHE=y
BR2_CCACHE_DIR="/ccache"
