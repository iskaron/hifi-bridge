# Hi-Fi Bridge common package set (applied on top of the upstream Raspberry Pi 64-bit defconfig).
# Every line here is REQUIRED: scripts/os_check.sh fails if Kconfig silently drops one (unmet dependency).
# Rationale per package: docs/PHASE2B_PLAN.md section 1.
BR2_TARGET_GENERIC_HOSTNAME="hifi-bridge"
BR2_TARGET_GENERIC_ISSUE="Hi-Fi Bridge"
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_ROOTFS_MERGED_USR=y
# read-only root (P4, PRODUCT_SPEC): never remounted read-write. /var is an overlayfs with a tmpfs upper (RAM: volatile logs and
# caches); persistent state lives only on the data partition (bind mounts from /data, post-build.sh)
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_INIT_SYSTEMD_VAR_OVERLAYFS=y
# reproducible build (SOURCE_DATE_EPOCH = commit date of the pinned Buildroot, TZ=UTC, LANG=C); results in docs/IMAGE_BUILD.md
BR2_REPRODUCIBLE=y
# BR2_PACKAGE_SYSTEMD_JOURNAL_REMOTE is not set
# runtime
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON_JEEPNEY=y
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_DBUS=y
# Bluetooth + audio graph (PipeWire's BlueZ plugin needs bluez5_utils + sbc + glib; pw-cat needs libsndfile)
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_SBC=y
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_PIPEWIRE=y
# WirePlumber needs Lua >= 5.3 (found by scripts/os_defconfigs.sh: without it Kconfig silently drops WirePlumber)
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_LIBSNDFILE=y
# mDNS (DECISIONS #49)
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
# network: client Wi-Fi OR setup hotspot (never both), regulatory database
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_HOSTAPD_WPA3=y
BR2_PACKAGE_DNSMASQ=y
# network management (docs/NETWORK.md): firewall, control sockets for the agent, networkd addresses, timesyncd, hostnamed
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_SYSTEMD_HOSTNAMED=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
# updates: RAUC (P3, provisional bootloader integration via U-Boot boot-count) + U-Boot env tools
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_DBUS=y
BR2_PACKAGE_RAUC_JSON=y
# BR2_PACKAGE_RAUC_STREAMING is not set
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_UBOOT_TOOLS_FWPRINTENV=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
# BR2_PACKAGE_DOSFSTOOLS is not set
# firewall tool (nftables) for the network stream's ruleset; added by the OS stream so that the measured image sizes include it
BR2_PACKAGE_NFTABLES=y
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rpi_arm64"
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
# rootfs + images (sizes are placeholders until measured, P4)
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# fixed file-system UUID and directory hash seed: mke2fs otherwise draws both at random, which makes every rootfs.ext4 different.
# Slots are mounted by partition (/dev/mmcblk0p2/3), never by UUID, and A/B copies share the UUID anyway. Read-only fs: no hash-DoS.
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit -U 8d3b1c54-2f0e-4a51-9c7e-3f1a6e0b9d21 -E hash_seed=8d3b1c54-2f0e-4a51-9c7e-3f1a6e0b9d21"
# each A/B slot carries its own kernel: boot.cmd loads /boot/Image from the selected rootfs (the FAT holds firmware + U-Boot only)
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_RAUC=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT_SOURCE="$(BR2_EXTERNAL_HIFI_BRIDGE_PATH)/board/hifi-bridge/uboot/boot.cmd"
BR2_PACKAGE_HOST_E2FSPROGS=y
# product
BR2_PACKAGE_HIFI_BRIDGE=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HIFI_BRIDGE_PATH)/board/hifi-bridge/overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HIFI_BRIDGE_PATH)/board/hifi-bridge/post-image.sh"
BR2_ENABLE_LOCALE_PURGE=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US de_DE"
# first-boot growth of the data partition (MBR: systemd-repart is GPT-only, so sfdisk + resize2fs)
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
