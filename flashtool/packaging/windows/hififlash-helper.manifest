<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows application manifest of the WRITE HELPER only (docs/FLASH_TOOL.md §4): it always runs elevated (UAC prompt). The GUI
     executable gets no such manifest and runs as the normal user. PREPARED, NOT YET BUILT OR TESTED ON WINDOWS (G3 F-6). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="HiFiBridge.FlashTool.Helper" version="0.1.0.0"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>  <!-- Windows 10 / 11 -->
    </application>
  </compatibility>
</assembly>
