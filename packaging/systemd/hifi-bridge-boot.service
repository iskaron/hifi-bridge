# Processes the boot partition BEFORE the bridge starts (P6 provisioning, P8 recovery request, P7 CA + non-secret status file).
# The only unit with write access to /boot; the main service has none. On the image the FAT is root-owned and this unit gets write
# access through the group hifi-boot (drop-in hifi-bridge-boot.service.d/boot-fat.conf in the OS overlay, review N-14).
[Unit]
Description=Hi-Fi Bridge boot-partition files (provisioning, recovery, status)
RequiresMountsFor=/boot /var/lib/hifi-bridge
Before=hifi-bridge.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -m btbridge.bootfiles --data /var/lib/hifi-bridge --boot /boot
Environment=PYTHONPATH=/usr/lib/hifi-bridge PYTHONUNBUFFERED=1
User=hifi-bridge
Group=hifi-bridge
StateDirectory=hifi-bridge
StateDirectoryMode=0700
ReadWritePaths=/boot
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# no network at all: this step only reads/writes files on /boot and in the state directory
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# no ProcSubset=pid: the owner-requested snapshot restore reads the booted slot (rauc.slot=) from /proc/cmdline (docs/OTA.md 6)
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
IPAddressDeny=any
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
