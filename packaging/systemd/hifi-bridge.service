# Hi-Fi Bridge appliance service - PREPARATION for phase 2b (not yet installed on any image; verified with systemd-analyze only).
# Restart strategy: docs/SERVICE_SUPERVISION.md
[Unit]
Description=Hi-Fi Bridge (Bluetooth audio for Lyrion)
Documentation=file:///usr/share/doc/hifi-bridge/SERVICE_SUPERVISION.md
After=network-online.target bluetooth.service pipewire.service wireplumber.service pipewire-pulse.service
Wants=network-online.target bluetooth.service
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -m btbridge.appliance --data /var/lib/hifi-bridge --source bluez --http-port 80 --https-port 443 --updates rauc
Environment=PYTHONPATH=/usr/lib/hifi-bridge PYTHONUNBUFFERED=1
# health() not 'failed' -> WATCHDOG=1 every 15 s; a hung control loop stops the pings -> SIGABRT + restart
WatchdogSec=30
Restart=always
RestartSec=2
TimeoutStartSec=60
TimeoutStopSec=15
KillSignal=SIGTERM
User=hifi-bridge
Group=hifi-bridge
SupplementaryGroups=bluetooth audio
StateDirectory=hifi-bridge
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
# the only path outside the state directory: a reboot request file for hifi-bridge-reboot.path (docs/OTA.md section 5)
ReadWritePaths=-/run/hifi-bridge-ota
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
